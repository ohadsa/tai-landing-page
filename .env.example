# Copy to .env.local for local development.
#
# Pasting these into a hosting dashboard instead? Enter the value WITHOUT the
# surrounding quotes. A .env file is read by dotenv, which strips them; a
# dashboard field stores whatever you type, so quotes become part of the value
# and every submission is refused — a failure that appears only in production.
# The code strips stray quotes and whitespace defensively, but do not rely on it.

# The Apps Script Web App that records leads. Find it in the Apps Script editor
# under Deploy > Manage deployments; the URL ends in /exec.
LEADS_SHEET_WEBHOOK_URL="https://script.google.com/macros/s/.../exec"

# Must match SECRET in apps-script/Code.gs as deployed, exactly. When it does
# not, the script answers {"ok":false,"error":"unauthorized"}, the lead is not
# recorded, and the visitor is told the message did not send.
LEADS_SHEET_SECRET=""
